# Lantor creates this SQLite database automatically on first start.
# Default: sqlite://~/Library/Application Support/Lantor/lantor.sqlite
# LANTOR_DATABASE_URL=sqlite://~/Library/Application Support/Lantor/lantor.sqlite
# `DATABASE_URL` is honored as a fallback only when it is also a sqlite: URL.

# Override where copied message attachments are stored.
# Default: ~/Library/Application Support/Lantor/attachments
# LANTOR_ATTACHMENT_DIR=/Users/you/Library/Application Support/Lantor/attachments

# Browser/Tailscale access defaults to 0.0.0.0:8787. Override to 127.0.0.1:8787
# to keep it loopback-only, or set to "off" / "none" to disable the web server.
# LANTOR_WEB_BIND=0.0.0.0:8787

# Base URL used when Lantor generates web links. If unset, Lantor derives a
# local URL from LANTOR_WEB_BIND.
# LANTOR_WEB_PUBLIC_URL=http://127.0.0.1:8787

# Optional shared token required by the browser UI for /api/* and attachments.
# The browser remembers a successful token for 30 days.
# LANTOR_WEB_TOKEN=change-me

# Override the static web bundle served by the desktop process.
# Default: auto-detect dist/ next to the repo or current working directory.
# LANTOR_WEB_DIST=/absolute/path/to/dist

# Rotate warm Codex sessions after the latest stopped run exceeds this many
# input tokens. Values below 50000 are ignored.
# LANTOR_CODEX_CONTEXT_ROTATE_INPUT_TOKENS=180000

# Backend voice transcription provider for the voice-agent entry path.
# On macOS, leaving this unset uses Apple Speech. Set it explicitly to override.
# LANTOR_TRANSCRIPTION_PROVIDER=apple

# If LANTOR_TRANSCRIPTION_COMMAND is set, Lantor sends audio bytes on stdin and
# reads either plain transcript text or JSON like {"text":"..."} from stdout.
# LANTOR_TRANSCRIPTION_PROVIDER=command
# LANTOR_TRANSCRIPTION_COMMAND=/absolute/path/to/transcribe-audio

# Provider-free local verification path. Recorded production audio should use
# a real command/provider; deterministic returns stable text for test bytes.
# LANTOR_TRANSCRIPTION_PROVIDER=deterministic

# Call Mode coordinator defaults to a generated codex exec command that reads
# request JSON on stdin and returns a JSON tool call with spoken say text.
# Override the command only to route through another local Dispatcher service.
# LANTOR_CALL_COORDINATOR_COMMAND=/absolute/path/to/call-coordinator
# LANTOR_CALL_COORDINATOR_MODEL=gpt-5.4-mini
# LANTOR_CALL_COORDINATOR_REASONING_EFFORT=low

# Call Mode worker-reply/completion feedback defaults to a generated codex exec
# command that reads request JSON on stdin and returns {"message_text":"..."}.
# Override the command only to route through another local feedback generator.
# LANTOR_CALL_FEEDBACK_COMMAND=/absolute/path/to/call-feedback
# LANTOR_CALL_FEEDBACK_MODEL=gpt-5.4-mini
# LANTOR_CALL_FEEDBACK_REASONING_EFFORT=low
